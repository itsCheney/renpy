# Answers for checks configure can't run when cross-building CPython for
# iOS (after renpy-build).
ac_cv_file__dev_ptmx=no
ac_cv_file__dev_ptc=no
ac_cv_little_endian_double=yes
ac_cv_func_getentropy=no
ac_cv_have_long_long_format=yes
ac_cv_func_clock_settime=no
ac_cv_func_dup3=no
ac_cv_func_pipe2=no

# Modules mikage/python/Setup.stdlib leaves out. Marking them n/a keeps
# configure from planning them as shared modules (nis, for one, needs headers
# iOS doesn't have).
for mikage_module in _crypt _ctypes_test _curses _curses_panel _dbm _decimal \
    _gdbm _hashlib _multiprocessing _posixshmem _sqlite3 _ssl _testbuffer \
    _testcapi _testclinic _testimportmultiple _testinternalcapi \
    _testmultiphase _testsinglephase _tkinter _uuid _xxinterpchannels \
    _xxsubinterpreters _xxtestfuzz audioop nis ossaudiodev readline spwd \
    syslog xxlimited xxlimited_35 xxsubtype; do
    eval "py_cv_module_${mikage_module}=n/a"
done
unset mikage_module
